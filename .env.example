# Backend Configuration
PROJECT_NAME=StockSense
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=True

# Security & JWT
SECRET_KEY=stocksense-super-secret-development-key-change-in-production-32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stocksense_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stocksense_db
# Synchronous URL for Alembic migrations
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stocksense_db

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
